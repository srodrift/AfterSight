# Reasoning + vision model: set ONE (OpenAI also enables voice)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides
# OPENAI_MODEL=gpt-4o
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# Managed HydraDB (optional)
HYDRA_DB_API_KEY=

# Self-hosted HydraDB (open-source graph-node). Leave URL empty to disable.
HYDRA_GRAPH_URL=
HYDRA_GRAPH_TOKEN=
HYDRA_GRAPH_NAMESPACE=default
HYDRA_GRAPH_ID=default
HYDRA_GRAPH_CELL_ID=cell-0

# Auto Memory (opt-in in the app): seconds between sampled frames, and a per-session cap
AUTO_MEMORY_INTERVAL_MS=10000
AUTO_MEMORY_MAX_SAMPLES=90

# Required before sharing any public/tunnel/hosted link
APP_PASSWORD=
